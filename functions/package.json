{
  "name": "studiely-web-functions",
  "description": "Studiely web-only Cloud Functions (IP trial pool). Deploy separately from EduPlayce.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "echo \"No compile step — lib/ is the source of truth\"",
    "deploy": "firebase deploy --only functions:studiely-web",
    "deploy:trial": "firebase deploy --only functions:studiely-web:getWebTrialStatus,functions:studiely-web:bootstrapWebTrial,functions:studiely-web:consumeWebTrial,functions:studiely-web:sealWebTrialIp,functions:studiely-web:mergeWebTrialOnSignIn"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0"
  },
  "private": true
}
