{
  "functions": [
    {
      "source": "functions",
      "codebase": "studiely-web",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "deploy",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog/full/:slug",
        "destination": "/blogs/:slug",
        "type": 301
      },
      {
        "source": "/blog",
        "destination": "/blogs",
        "type": 301
      },
      {
        "source": "/blog/:slug",
        "destination": "/blogs/:slug",
        "type": 301
      },
      {
        "source": "/contact-us",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/nyla-ai",
        "destination": "/nyla",
        "type": 301
      },
      {
        "source": "/start-free",
        "destination": "/signup",
        "type": 301
      },
      {
        "source": "/reset-password",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/app",
        "destination": "/home",
        "type": 301
      },
      {
        "source": "/app/",
        "destination": "/home",
        "type": 301
      },
      {
        "source": "/app/login",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/app/sign-up",
        "destination": "/signup",
        "type": 301
      },
      {
        "source": "/app/signup",
        "destination": "/signup",
        "type": 301
      },
      {
        "source": "/app/nyla",
        "destination": "/smartlink",
        "type": 301
      },
      {
        "source": "/app/pricing",
        "destination": "/pricing",
        "type": 301
      },
      {
        "source": "/app/pricing/",
        "destination": "/pricing",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-cache, no-store, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|jpg|jpeg|png|webp|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": []
  }
}
